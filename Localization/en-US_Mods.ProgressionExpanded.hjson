Configs: {
	ProgressionConfig: {
		DisplayName: Progression Expanded Config

		Headers: {
			XPBarSettings: XP Bar Settings
			LevelDisplaySettings: Level Display Settings
			HealthBarSettings: Health Bar Settings Header
			ManaBarSettings: Mana Bar Settings
			VengeanceReadoutSettings: Vengeance Readout Settings
			ResolveReadoutSettings: Resolve Readout Settings
		}

		ShowXPBar: {
			Label: Show XP Bar
			Tooltip: Enable or disable the XP bar display
		}

		XPBarX: {
			Label: XP Bar X Position
			Tooltip: Horizontal position of the XP bar (pixels from left)
		}

		XPBarY: {
			Label: XP Bar Y Position
			Tooltip: Vertical position of the XP bar (pixels from bottom)
		}

		XPBarScale: {
			Label: XP Bar Scale
			Tooltip: Size multiplier for the XP bar
		}

		ShowPlayerLevels: {
			Label: Show Player Levels
			Tooltip: Show level tags below players
		}

		ShowNPCLevels: {
			Label: Show NPC Levels
			Tooltip: Show level tags above NPCs
		}

		ShowOnlyWhenHovered: {
			Label: Show Only When Hovering
			Tooltip: Only display level tags when hovering over entities
		}

		ShowCustomHealthBar: {
			Label: Show Custom Health Bar
			Tooltip: ""
		}

		HideVanillaHearts: {
			Label: Hide Vanilla Hearts
			Tooltip: ""
		}

		HealthBarX: {
			Label: Health Bar X
			Tooltip: ""
		}

		HealthBarY: {
			Label: Health Bar Y
			Tooltip: ""
		}

		HealthBarScale: {
			Label: Health Bar Scale
			Tooltip: ""
		}

		ShowCustomManaBar: {
			Label: Show Custom Mana Bar
			Tooltip: Enable or disable the custom mana bar display
		}

		HideVanillaMana: {
			Tooltip: Hide the vanilla mana stars. Ignored unless the custom mana bar is shown.
			Label: Hide Vanilla Mana
		}

		ManaBarX: {
			Label: Mana Bar X
			Tooltip: Horizontal position of the mana bar (pixels from left)
		}

		ManaBarY: {
			Label: Mana Bar Y
			Tooltip: Vertical position of the mana bar (pixels from bottom)
		}

		ManaBarScale: {
			Label: Mana Bar Scale
			Tooltip: Size multiplier for the mana bar
		}

		ShowVengeanceReadout: {
			Label: Show Vengeance Readout
			Tooltip: Show damage taken in the last 4 seconds and the bonus it is buying. Only appears while the Vengeance talent is picked and ramping.
		}

		VengeanceReadoutX: {
			Label: Vengeance Readout X
			Tooltip: Horizontal position (pixels from left)
		}

		VengeanceReadoutY: {
			Label: Vengeance Readout Y
			Tooltip: Vertical position (pixels from bottom)
		}

		VengeanceReadoutScale: {
			Label: Vengeance Readout Scale
			Tooltip: Size multiplier for the Vengeance readout
		}

		ShowResolveReadout: {
			Label: Show Resolve Readout
			Tooltip: Show how hardened you are and the damage reduction it is buying. Only appears while the Juggernaut talent is picked and taking fire.
		}

		ResolveReadoutX: {
			Label: Resolve Readout X
			Tooltip: Horizontal position (pixels from left)
		}

		ResolveReadoutY: {
			Label: Resolve Readout Y
			Tooltip: Vertical position (pixels from bottom)
		}

		ResolveReadoutScale: {
			Label: Resolve Readout Scale
			Tooltip: Size multiplier for the Resolve readout
		}
	}
}

